# ==========================================
# SWPA MERCH STORE CONFIGURATION
# ==========================================

# PayPal API Credentials (from https://developer.paypal.com/dashboard/)
# In Sandbox mode for testing, or Live for production:
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Inkthreadable API Credentials (from https://www.inkthreadable.co.uk/profile/api)
INKTHREADABLE_APP_ID=your_inkthreadable_app_id
INKTHREADABLE_API_KEY=your_inkthreadable_api_key

# Store Shipping & Pricing Settings
# PayPal domestic fee formula: 2.9% + £0.30 per sale
STORE_CURRENCY=GBP
STANDARD_SHIPPING_FEE=4.99
FREE_SHIPPING_THRESHOLD=60.00
